# -------------------------------------------------------------
# ProofHire - Environment Variables Template (.env.example)
# Copy this file to .env (DO NOT commit your actual .env file!)
# -------------------------------------------------------------

# --- Frontend Public Configuration (Vite) ---
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anon / Publishable Public Key (safe for browser)
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# Backend Express API URL
VITE_API_BASE_URL=http://localhost:5000/api

# OpenRouter AI API Key for client-side ATS Resume & Job Parsing (Optional)
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here


# --- Server-Side Only Configuration (DO NOT expose to client) ---
PORT=5000
NODE_ENV=development

# Server connection to Supabase
SUPABASE_URL=https://your-project-id.supabase.co
# Supabase Service Role Key (BYPASSES RLS - Keep strictly private on server)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# LLM API (Groq, OpenAI, or Gemini for structured JD parsing / resume analysis)
LLM_API_KEY=your_llm_api_key_here

# GitHub REST API Token (Optional, server-side to prevent rate-limits on repo inspection)
GITHUB_TOKEN=your_github_personal_access_token_here
